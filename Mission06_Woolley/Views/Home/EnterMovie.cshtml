@model Movie

@{
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm">
        <div class="card-body">

            <h1 class="mb-4 text-center">Enter Movie Into The Collection</h1>

            <!-- Add Movie Form -->
            <form method="post">
                <h2 class="h4 mb-4">Add a New Movie</h2>

                <!-- Title (required) -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title *</label>
                    <input asp-for="Title"
                           type="text"
                           id="Title"
                           name="Title"
                           required
                           maxlength="100"
                           placeholder="e.g., Inception"
                           class="form-control" />
                </div>

                <!-- Category / Genre (required) -->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category *</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Select a Category</option>
                        @foreach (Categories c in ViewBag.Categories)
                        {
                            <option value="@c.CategoryId">@c.CategoryName</option>
                        }
                    </select>
                </div>

                <!-- Year (required) -->
                <div class="mb-3">
                    <label asp-for="Year" class="form-label">Year *</label>
                    <input type="number"
                           id="Year"
                           name="Year"
                           required
                           min="1888"
                           max="2100"
                           placeholder="e.g., 2010"
                           class="form-control" />
                </div>

                <!-- Director (required) -->
                <div class="mb-3">
                    <label asp-for="Director" class="form-label">Director *</label>
                    <input type="text"
                           id="Director"
                           name="Director"
                           required
                           maxlength="60"
                           placeholder="e.g., Christopher Nolan"
                           class="form-control" />
                </div>

                <!-- Rating (required dropdown: G, PG, PG-13, R) -->
                <div class="mb-3">
                    <label asp-for="Rating" class="form-label">Rating *</label>
                    <select id="Rating" name="Rating" required class="form-select">
                        <option value="" selected disabled>-- Select --</option>
                        <option value="G">G</option>
                        <option value="PG">PG</option>
                        <option value="PG-13">PG-13</option>
                        <option value="R">R</option>
                    </select>
                </div>

                <!-- Edited (optional yes/no true/false) -->
                <div class="mb-3">
                    <label asp-for="Edited" class="form-label">Edited (optional)</label>
                    <select id="Edited" name="Edited" class="form-select">
                        <option value="" selected>-- Not specified --</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>

                <!-- Lent To (optional) -->
                <div class="mb-3">
                    <label asp-for="LentTo" class="form-label">Lent To (optional)</label>
                    <input type="text"
                           id="LentTo"
                           name="LentTo"
                           maxlength="60"
                           placeholder="e.g., Jake"
                           class="form-control" />
                </div>

                <!-- Copied To Plex -->
                <div class="mb-3">
                    <label asp-for="CopiedToPlex" class="form-label">Copied to Plex</label>
                    <select id="CopiedToPlex" name="CopiedToPlex" class="form-select">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>

                <!-- Notes (optional, max 25 chars) -->
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">Notes (optional, max 25 chars)</label>
                    <input type="text"
                           id="Notes"
                           name="Notes"
                           maxlength="25"
                           placeholder="e.g., 4K steelbook"
                           class="form-control" />
                </div>

                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary px-4">Add Movie</button>
                </div>
            </form>

        </div>
    </div>
</div>
