@model Movie

<div class="container mt-4 mb-5">
    <div class="card shadow-sm">
        <div class="card-body">

            <h1 class="mb-4 text-center">Enter Movie Into The Collection</h1>

            <form method="post">

                <!-- IMPORTANT: allows Edit to work -->
                <input asp-for="MovieId" type="hidden" />

                <h2 class="h4 mb-4">Add a New Movie</h2>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Title *</label>
                    <input asp-for="Title"
                           class="form-control"
                           required
                           maxlength="100"
                           placeholder="e.g., Inception" />
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category *</label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">Select a Category</option>
                        @foreach (Categories c in ViewBag.Categories)
                        {
                            <option value="@c.CategoryId">@c.CategoryName</option>
                        }
                    </select>
                </div>

                <!-- Year -->
                <div class="mb-3">
                    <label asp-for="Year" class="form-label">Year *</label>
                    <input asp-for="Year"
                           type="number"
                           class="form-control"
                           required
                           min="1888"
                           max="2100"
                           placeholder="e.g., 2010" />
                </div>

                <!-- Director -->
                <div class="mb-3">
                    <label asp-for="Director" class="form-label">Director *</label>
                    <input asp-for="Director"
                           class="form-control"
                           required
                           maxlength="60"
                           placeholder="e.g., Christopher Nolan" />
                </div>

                <!-- Rating -->
                <div class="mb-3">
                    <label asp-for="Rating" class="form-label">Rating *</label>
                    <select asp-for="Rating" class="form-select" required>
                        <option value="" disabled>-- Select --</option>
                        <option value="G">G</option>
                        <option value="PG">PG</option>
                        <option value="PG-13">PG-13</option>
                        <option value="R">R</option>
                    </select>
                </div>

                <!-- Edited -->
                <div class="mb-3">
                    <label asp-for="Edited" class="form-label">Edited (optional)</label>
                    <select asp-for="Edited" class="form-select">
                        <option value="">-- Not specified --</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>

                <!-- Lent To -->
                <div class="mb-3">
                    <label asp-for="LentTo" class="form-label">Lent To (optional)</label>
                    <input asp-for="LentTo"
                           class="form-control"
                           maxlength="60"
                           placeholder="e.g., Jake" />
                </div>

                <!-- Copied To Plex -->
                <div class="mb-3">
                    <label asp-for="CopiedToPlex" class="form-label">Copied to Plex</label>
                    <select asp-for="CopiedToPlex" class="form-select">
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </select>
                </div>

                <!-- Notes -->
                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">Notes (optional, max 25 chars)</label>
                    <input asp-for="Notes"
                           class="form-control"
                           maxlength="25"
                           placeholder="e.g., 4K steelbook" />
                </div>

                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary px-4">
                        Add Movie
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
